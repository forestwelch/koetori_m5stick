#ifndef SECRETS_H
#define SECRETS_H

// WiFi networks
// Add your WiFi networks here. You can have multiple networks.
struct WiFiNetwork {
  const char* ssid;
  const char* password;
};

WiFiNetwork wifiNetworks[] = {
  {"YourWiFiSSID", "YourWiFiPassword"},
  {"AnotherNetwork", "AnotherPassword"},
};
const int numNetworks = 2;  // Update this if you add/remove networks

// API configuration
// Get your API key from your Koetori deployment
const char* API_KEY = "your-api-key-here";

// Device ID - unique identifier for this M5Stick device
const char* DEVICE_ID = "m5stick-yourname-001";

// Username - your Koetori username
const char* USERNAME = "yourname";

#endif



